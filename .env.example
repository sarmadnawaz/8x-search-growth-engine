# The dashboard runs with none of these — the committed SQLite file is seeded.
# Keys are only needed to run a live pipeline; every adapter falls back to its
# cached fixture (`--replay`) when a key is missing.

DATABASE_URL="file:./dev.db"

# Google Cloud API key with PageSpeed Insights enabled (free)
PSI_API_KEY=

# serper.dev — 2,500 free credits, no card
SERPER_API_KEY=

# Perplexity (search-grounded; the only probe engine that can cite domains
# newer than a model's training data)
PERPLEXITY_API_KEY=

# Anthropic — asset generation stages
ANTHROPIC_API_KEY=
