# Database. The compose stack provides one; point this at it.
#   compose up -d db   ->   port 5433 by default (override with POSTGRES_PORT)
DATABASE_URL="postgresql://sge:sge_local_dev@localhost:5433/sge?schema=public"

# Integration tests run against their own database so they never touch the one
# you are looking at.
DATABASE_URL_TEST="postgresql://sge:sge_local_dev@localhost:5433/sge_test?schema=public"

# Host ports, in case 5433/3000 are taken by another stack.
POSTGRES_PORT=5433
APP_PORT=3000

# --- Adapter credentials -----------------------------------------------------
# All optional. A missing key degrades one evidence family and is reported on
# the snapshot; it never fails a run, and the engine never invents the data.

# Google Cloud key with PageSpeed Insights enabled (free)
PSI_API_KEY=

# serper.dev — 2,500 free credits, no card
SERPER_API_KEY=

# --- Language model -----------------------------------------------------------
# Two routes behind one interface; whichever key is present is used. Both are
# optional: without either, generated assets fall back to their deterministic
# templates and the AI-visibility probe declines to run.

# Preferred. The Responses API exposes web search as a tool and returns the URLs
# it consulted, which is what the AI-visibility probe measures. A probe that
# cannot search measures training data, not visibility — so it refuses instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Set to `none` to disable model calls entirely. Tests pin this so a developer
# key in the environment cannot turn a deterministic suite into one that makes
# paid network calls and returns different output each run.
LLM_PROVIDER=
