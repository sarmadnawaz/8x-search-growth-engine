l=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/7f015da875473d23.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/4b43e4138173b37c.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/247eb132b7f7b574.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/6feb6288867f3606.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><script src=\"/_next/static/chunks/10799ad36ad8d966.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Brawnix: Train for both</title><meta name=\"description\" content=\"The coach for hybrid athletes. Log lifts and cardio in plain English. Brawnix catches when your training collides and tells you when to back off.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.8f2c045d.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon-32x32.png\"/><link rel=\"icon\" href=\"/favicon-16x16.png\" sizes=\"16x16\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script>\n(function () {\n  try {\n    var stored = localStorage.getItem(\"brawnix-theme\");\n    if (stored !== \"light\") document.documentElement.classList.add(\"dark\");\n  } catch (e) {\n    document.documentElement.classList.add(\"dark\");\n  }\n})();\n</script><script src=\"/_next/static/chunks/a6dad97d9634a72d.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" noModule=\"\"></script></head><body class=\"geist_a8fa0c1a-module__MXp6vq__variable barlow_condensed_a27d1ee9-module__Kj2-cq__variable font-sans antialiased flex flex-col min-h-screen\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex-1 flex flex-col\"><div class=\"min-h-screen bg-background\"><nav class=\"md:hidden border-b border-border/50 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50 w-full\"><div class=\"container mx-auto px-6 py-5\"><div class=\"flex items-center justify-between\"><a class=\"flex items-center gap-1.5 font-display text-2xl font-extrabold italic uppercase leading-none tracking-tight hover:opacity-80 transition-opacity\" href=\"/\"><img src=\"/logo.png\" alt=\"\" aria-hidden=\"true\" class=\"object-contain h-9 w-9\"/>Brawn<span class=\"text-primary\">ix</span></a><div class=\"flex items-center gap-1\"><div class=\"size-9\" aria-hidden=\"true\"></div><button class=\"p-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-6 h-6\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></div></nav><nav class=\"hidden md:block border-b border-border/50 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50\"><div class=\"container mx-auto px-6 py-5\"><div class=\"flex items-center justify-between\"><a class=\"flex items-center gap-2 font-display text-3xl font-extrabold italic uppercase leading-none tracking-tight hover:opacity-80 transition-opacity\" href=\"/\"><img src=\"/logo.png\" alt=\"\" aria-hidden=\"true\" class=\"object-contain h-10 w-10\"/>Brawn<span class=\"text-primary\">ix</span></a><div class=\"flex items-center gap-3\"><div class=\"size-9\" aria-hidden=\"true\"></div></div></div></div></nav><div class=\"container mx-auto px-6 py-16 max-w-4xl\"><div class=\"mb-12\"><h1 class=\"text-5xl md:text-6xl font-light tracking-tight mb-4\">Privacy <span class=\"italic\">Policy</span></h1><p class=\"text-lg text-muted-foreground font-light\">Last updated: July 2026</p></div><div class=\"prose prose-lg dark:prose-invert max-w-none\"><section class=\"mb-8\"><p class=\"text-muted-foreground leading-relaxed mb-4\">Brawnix (&quot;we&quot;, &quot;us&quot;) is a hybrid strength-and-endurance training app. This policy explains what we collect, why, who we share it with, and the choices you have. By using the Brawnix app or website you agree to the practices described here.</p></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Information We Collect</h2><ul class=\"space-y-2 text-muted-foreground ml-6\"><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Account:</strong> your email address. We sign you in with a one-time email code — Brawnix does not use or store passwords.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Profile:</strong> the details you provide during onboarding or on your profile — display name, age, gender, current and goal weight, how often you run and do other cardio, and an optional profile photo.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Training data:</strong> the workouts, runs and cardio sessions you log, including strength sets, durations, intensity and dates.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">AI Coach &amp; voice logging:</strong> the messages you send to the AI Coach and the text of what you say to the voice logger. Speech is transcribed to text on your device (or by your device&#x27;s platform speech service); we send that text — with a short summary of your profile for context — to our AI provider to generate a reply or a structured workout log.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Subscription:</strong> your plan (free, Pro or Max) and its status. Payments are handled by the Apple App Store; we never receive your card details.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Usage &amp; device data:</strong> basic analytics and diagnostics (e.g. which features are used, crashes) to keep the app working and improve it.</li></ul></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">How We Use Your Information</h2><ul class=\"space-y-2 text-muted-foreground ml-6\"><li class=\"leading-relaxed\">Provide the core app — sign-in, saving your logs, and syncing across devices.</li><li class=\"leading-relaxed\">Generate personalized coaching, session summaries and next-session suggestions.</li><li class=\"leading-relaxed\">Manage your subscription and unlock the features it includes.</li><li class=\"leading-relaxed\">Maintain, secure, debug and improve the service.</li></ul><p class=\"text-muted-foreground leading-relaxed mt-4\">We do not sell your personal information, and we do not use your training data or messages for advertising.</p></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Service Providers</h2><p class=\"text-muted-foreground leading-relaxed mb-4\">We share data with a small number of processors only as needed to run Brawnix:</p><ul class=\"space-y-2 text-muted-foreground ml-6\"><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Supabase</strong> — authentication, database and file storage for your account, profile photo and logs.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Google (Gemini API)</strong> — powers the AI Coach and voice-log parsing. We send the relevant message or transcript text; per Google&#x27;s API terms this content is not used to train their models.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Apple App Store &amp; RevenueCat</strong> — process and validate subscriptions.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Resend</strong> — delivers your one-time sign-in code emails.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">PostHog</strong> — privacy-friendly product analytics, in the mobile app only (not on this website).</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Google Analytics</strong> — website traffic measurement, on this site only (not in the app). It sets cookies, so we only load it if you accept analytics cookies in the banner; decline and it is never loaded. We do not use it for advertising.</li><li class=\"leading-relaxed\"><strong class=\"text-foreground\">Vercel</strong> — hosts the Brawnix website and API.</li></ul></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Data Retention</h2><p class=\"text-muted-foreground leading-relaxed\">We keep your data while your account is active. When you delete your account we remove your personal data from our systems, except where we must retain limited records to meet legal or accounting obligations.</p></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Your Rights &amp; Choices</h2><ul class=\"space-y-2 text-muted-foreground ml-6\"><li class=\"leading-relaxed\">View and edit your profile and logs directly in the app.</li><li class=\"leading-relaxed\">Delete your account and associated data at any time via the app, or at<!-- --> <a href=\"/delete-account\" class=\"text-foreground underline\">brawnix.fitness/delete-account</a>.</li><li class=\"leading-relaxed\">Request a copy of your data, or ask us a question, using the contact details below.</li></ul></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Children</h2><p class=\"text-muted-foreground leading-relaxed\">Brawnix is not intended for children under 13, and we do not knowingly collect data from them. If you believe a child has provided us information, contact us and we will delete it.</p></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Changes to This Policy</h2><p class=\"text-muted-foreground leading-relaxed\">We may update this policy as the app evolves. Material changes will be reflected here with a new &quot;last updated&quot; date.</p></section><section class=\"mb-8\"><h2 class=\"text-3xl font-light tracking-tight mb-4\">Contact</h2><p class=\"text-muted-foreground leading-relaxed\">Questions about this policy or your data? Reach us at<!-- --> <a href=\"mailto:privacy@brawnix.fitness\" class=\"text-foreground underline\">privacy@brawnix.fitness</a> <!-- -->or through our<!-- --> <a href=\"/contact\" class=\"text-foreground underline\">contact page</a>.</p></section></div></div></div><!--$--><!--/$--></div><footer class=\"border-t border-border/50 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 mt-auto\"><div class=\"container mx-auto px-6 py-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-4\"><div class=\"flex items-center gap-2.5 text-sm text-muted-foreground\"><img src=\"/logo.png\" alt=\"Brawnix logo\" class=\"h-7 w-7 object-contain\"/>© <!-- -->2026<!-- --> Brawnix. Train for both.</div><div class=\"flex items-center gap-6 text-sm\"><a class=\"text-muted-foreground hover:text-foreground transition-colors\" href=\"/privacy\">Privacy Policy</a><a class=\"text-muted-foreground hover:text-foreground transition-colors\" href=\"/terms\">Terms of Service</a><a class=\"text-muted-foreground hover:text-foreground transition-colors\" href=\"/contact\">Contact</a><a class=\"text-muted-foreground hover:text-foreground transition-colors\" href=\"/delete-account\">Delete account</a></div></div></div></footer><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--><script src=\"/_next/static/chunks/c3c1b24f0ad4b4a7.js?dpl=dpl_51VtyJf2oY6pauUj6ZwYpqLTkhjA\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[48205,[\\\"/_next/static/chunks/7f015da8